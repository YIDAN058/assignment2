@page "/mortgagecases/edit"
@using Microsoft.EntityFrameworkCore
@using assignment2.Data
@inject IDbContextFactory<assignment2.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>MortgageCase</h2>
<hr />
@if (MortgageCase is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="MortgageCase" OnValidSubmit="UpdateMortgageCase" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="MortgageCase.Id" value="@MortgageCase.Id" />
                <div class="mb-3">
                    <label for="customerid" class="form-label">CustomerId:</label>
                    <InputNumber id="customerid" @bind-Value="MortgageCase.CustomerId" class="form-control" />
                    <ValidationMessage For="() => MortgageCase.CustomerId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount:</label>
                    <InputNumber id="amount" @bind-Value="MortgageCase.Amount" class="form-control" />
                    <ValidationMessage For="() => MortgageCase.Amount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status:</label>
                    <InputText id="status" @bind-Value="MortgageCase.Status" class="form-control" />
                    <ValidationMessage For="() => MortgageCase.Status" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/mortgagecases">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private MortgageCase? MortgageCase { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        MortgageCase ??= await context.MortgageCases.FirstOrDefaultAsync(m => m.Id == Id);

        if (MortgageCase is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateMortgageCase()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(MortgageCase!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!MortgageCaseExists(MortgageCase!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/mortgagecases");
    }

    private bool MortgageCaseExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.MortgageCases.Any(e => e.Id == id);
    }
}
