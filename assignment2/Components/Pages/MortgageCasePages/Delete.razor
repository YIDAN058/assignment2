@page "/mortgagecases/delete"
@using Microsoft.EntityFrameworkCore
@using assignment2.Data
@inject IDbContextFactory<assignment2.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>MortgageCase</h2>
    <hr />
    @if (mortgagecase is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">CustomerId</dt>
            <dd class="col-sm-10">@mortgagecase.CustomerId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Amount</dt>
            <dd class="col-sm-10">@mortgagecase.Amount</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@mortgagecase.Status</dd>
        </dl>
        <EditForm method="post" Model="mortgagecase" OnValidSubmit="DeleteMortgageCase" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(mortgagecase is null)">Delete</button> |
            <a href="/mortgagecases">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private MortgageCase? mortgagecase;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        mortgagecase = await context.MortgageCases.FirstOrDefaultAsync(m => m.Id == Id);

        if (mortgagecase is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteMortgageCase()
    {
        using var context = DbFactory.CreateDbContext();
        context.MortgageCases.Remove(mortgagecase!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/mortgagecases");
    }
}
