@page "/mortgagecases/create"
@using Microsoft.EntityFrameworkCore
@using assignment2.Data
@inject IDbContextFactory<assignment2.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>MortgageCase</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="MortgageCase" OnValidSubmit="AddMortgageCase" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="customerid" class="form-label">Select Customer:</label> 
                <InputSelect id="customerid" @bind-Value="MortgageCase.CustomerId" class="form-control"> 
                    <option value="0">-- Select a Customer --</option>
                    @if (customers != null)
                    {
                        @foreach (var cust in customers)
                        {
                            <option value="@cust.Id">@cust.Name</option>
                        }
					}
            </InputSelect>
				<ValidationMessage For="() => MortgageCase.CustomerId" class="text-danger" />
            </div>        
            <div class="mb-3">
                <label for="amount" class="form-label">Amount:</label> 
                <InputNumber id="amount" @bind-Value="MortgageCase.Amount" class="form-control" /> 
                <ValidationMessage For="() => MortgageCase.Amount" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="status" class="form-label">Status:</label> 
                <InputText id="status" @bind-Value="MortgageCase.Status" class="form-control" /> 
                <ValidationMessage For="() => MortgageCase.Status" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/mortgagecases">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private MortgageCase MortgageCase { get; set; } = new();
	private List<Customer>? customers;
    protected override async Task OnInitializedAsync()
    {
		using var context = DbFactory.CreateDbContext();
		customers = await context.Customers.ToListAsync();
	}

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddMortgageCase()
    {
        using var context = DbFactory.CreateDbContext();
        context.MortgageCases.Add(MortgageCase);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/mortgagecases");
    }
}
